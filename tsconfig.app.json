{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode — Vite handles emit; tsc only type-checks. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,

    /* Type safety */
    "strict": true,
    "noUncheckedSideEffectImports": true,
    "noFallthroughCasesInSwitch": true,

    /* Unused-symbol checks are delegated to ESLint to keep the migration
       (and incremental edits) from failing the build on dead locals. */
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src"]
}
